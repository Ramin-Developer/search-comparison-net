<UserControl x:Class="SearchComparisonNet.GUI.UserControls.SimulationResultControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- DataContext of RootGrid is set to the control itself in code-behind so that
         Title/AvgIterations/AvgElapsedTime DependencyProperties are reachable via simple
         {Binding} paths, while the outer StatisticsControl bindings still resolve against
         the parent's DataContext (MainViewModel). -->
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource LabelStyle}"
                   Width="{StaticResource LabelHeaderWidth}" Foreground="Magenta"
                   HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                   Content="{Binding Title}" />

            <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Width="{StaticResource LabelWidth}" Content="Avg. No. of Iterations" />

            <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource LabelStyle}"
                   Width="{StaticResource LabelValueWidth}" HorizontalContentAlignment="Right"
                   Content="{Binding AvgIterations}" />

            <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}"
                   Width="{StaticResource LabelWidth}" Content="Avg. Elapsed Time (ms)" />

            <Label Grid.Row="2" Grid.Column="1" Style="{StaticResource LabelStyle}"
                   Width="{StaticResource LabelValueWidth}" HorizontalContentAlignment="Right"
                   Content="{Binding AvgElapsedTime}" />
        </Grid>
    </Border>
</UserControl>
