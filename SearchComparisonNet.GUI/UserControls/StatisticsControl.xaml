<UserControl x:Class="SearchComparisonNet.GUI.UserControls.StatisticsControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="clr-namespace:SearchComparisonNet.GUI.UserControls"
			 mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<local:SimulationResultControl Grid.Row="0"
			Title="Linear Simulation Results"
			AvgIterations="{Binding LinearAvgNoOfIterations, Converter={StaticResource NumStringConverter},
							Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			AvgElapsedTime="{Binding LinearAvgElapsedTime, Converter={StaticResource NumStringConverter},
							 Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<local:SimulationResultControl Grid.Row="1"
			Title="Binary Simulation Results"
			AvgIterations="{Binding BinaryAvgNoOfIterations, Converter={StaticResource NumStringConverter},
							Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			AvgElapsedTime="{Binding BinaryAvgElapsedTime, Converter={StaticResource NumStringConverter},
							 Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
	</Grid>
</UserControl>
