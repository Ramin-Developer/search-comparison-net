# Shared .gitignore template synced from developer-workflow.
# Copy this file into repositories that need consistent ignore rules for:
# - general OS/editor artifacts
# - .NET / C# / F# solutions
# - LaTeX / PDF projects
# - MATLAB / Octave work
# - common Python, Node.js, and JVM tooling

# -------------------------
# OS files
# -------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride

# -------------------------
# Editors and IDEs
# -------------------------
.vs/
.vscode/
.idea/
.localhistory/
Generated\ Files/
MigrationBackup/
*.rsuser
*.suo
*.swp
*.swo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*~

